# Copy to .env and fill in. Never commit .env.

# local | azure
RUN_MODE=local

# Replay
MATCH_DIR=data/samples/match_42
REPLAY_SPEED=1
REPLAY_AUTOPLAY=false
PRECOMPUTE_ANALYSIS=true

# Azure OpenAI in Foundry
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_NANO=gpt-5.4-nano
AZURE_OPENAI_DEPLOYMENT_FALLBACK=gpt-4.1-mini
AZURE_OPENAI_REASONING_EFFORT=minimal

# Azure AI Translator (Free F0)
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Azure (Phase 8)
EVENTHUB_NAMESPACE=
EVENTHUB_NAME=
COSMOS_ENDPOINT=
SIGNALR_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Web
VITE_API_URL=http://localhost:8000
