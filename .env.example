# Copy to .env and fill in. Never commit .env.

# local | azure
RUN_MODE=local

# Replay
MATCH_DIR=data/samples/match_42
REPLAY_SPEED=1
REPLAY_AUTOPLAY=false
PRECOMPUTE_ANALYSIS=true

# Agents
MCP_URL=http://127.0.0.1:8000/mcp/
AGENT_TIMEOUT_S=25
AGENT_CACHE_PATH=data/cache/agent_responses.json

# Azure OpenAI in Foundry
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_NANO=gpt-5.4-nano
AZURE_OPENAI_DEPLOYMENT_FALLBACK=gpt-4.1-mini
AZURE_OPENAI_REASONING_EFFORT=minimal

# Azure AI Translator (Free F0)
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Azure (Phase 8). In Azure these are set by Bicep; the app uses its managed identity.
EVENTHUB_NAMESPACE=
EVENTHUB_NAME=match
COSMOS_ENDPOINT=
SIGNALR_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=
USE_MANAGED_IDENTITY_FOR_OPENAI=false

# Local: run the live-broadcast path (no seek, personal clips) without Event Hubs
LIVE_SIMULATION=false

# Web
VITE_API_URL=http://localhost:8000
