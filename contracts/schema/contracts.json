    "Event": {
      "additionalProperties": false,
      "description": "One on-ball or match action. `outcome` is always from `player_id`'s point of view.\n\npass / cross: player = passer, target = intended receiver; `end` is the intended point even\n    when the pass fails (the interception event says where it was won).\nshot: outcome success = goal; first tag is goal | saved | wide.\ninterception: player = the one who won the ball.\ntackle: player = tackler, target = ball carrier.\ndribble: player = carrier, target = defender being beaten (or not).\naerial_duel: player = the defending-side player (the team that did not deliver the ball),\n    target = the attacker; success = the defender won it.\npressure: player = presser, target = carrier, `pressure` 0-1 from their distance.\nfoul: player = offender, target = fouled player.\nsubstitution: player = player coming on, target = player going off.\npossession_change: team/player = who now has the ball.\nScripted ground truth carries the tags `scripted` and `scripted:<moment type>`.",
      "properties": {
        "ball_height_m": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ball Height M"
        },
        "ball_speed_ms": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ball Speed Ms"
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "frame_ref": {
          "minimum": 0,
          "title": "Frame Ref",
          "type": "integer"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "pressure": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure"
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        }
      },
      "required": [
        "event_id",
        "t_ms",
        "period",
        "type",
        "frame_ref"
      ],
      "title": "Event",
      "type": "object"
