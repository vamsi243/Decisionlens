{
  "$defs": {
    "ActionKind": {
      "enum": [
        "pass",
        "cross",
        "shot",
        "dribble",
        "carry",
        "clear",
        "header",
        "recovery_run"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "Archetype": {
      "enum": [
        "goalkeeper",
        "aerial_cb",
        "ball_playing_cb",
        "overlapping_fb",
        "deep_playmaker",
        "box_to_box",
        "pressing_forward",
        "target_man",
        "winger"
      ],
      "title": "Archetype",
      "type": "string"
    },
    "Driver": {
      "additionalProperties": false,
      "description": "One reason the counterfactual differs, e.g. factor=jump_reach, delta=+12, unit=cm.",
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "factor": {
          "title": "Factor",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "factor",
        "delta",
        "unit",
        "text"
      ],
      "title": "Driver",
      "type": "object"
    },
    "FrameRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "FrameRange",
      "type": "object"
    },
    "KeyMoment": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "frame_range": {
          "$ref": "#/$defs/FrameRange"
        },
        "importance": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Importance",
          "type": "number"
        },
        "moment_id": {
          "title": "Moment Id",
          "type": "string"
        },
        "players": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Players",
          "type": "array"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/MomentType"
        }
      },
      "required": [
        "moment_id",
        "t_ms",
        "type",
        "players",
        "frame_range"
      ],
      "title": "KeyMoment",
      "type": "object"
    },
    "MomentType": {
      "enum": [
        "aerial_duel",
        "recovery_run",
        "big_chance",
        "line_breaking_pass",
        "press_turnover",
        "goal",
        "fatigue_alert"
      ],
      "title": "MomentType",
      "type": "string"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "chosen": {
          "default": false,
          "title": "Chosen",
          "type": "boolean"
        },
        "option_id": {
          "title": "Option Id",
          "type": "string"
        },
        "p_success": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Success",
          "type": "number"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "minItems": 2,
          "title": "Path",
          "type": "array"
        },
        "range": {
          "$ref": "#/$defs/ProbRange"
        },
        "target": {
          "$ref": "#/$defs/Point"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "xt_gain": {
          "maximum": 1,
          "minimum": -1,
          "title": "Xt Gain",
          "type": "number"
        }
      },
      "required": [
        "option_id",
        "action",
        "target",
        "p_success",
        "range",
        "xt_gain",
        "path"
      ],
      "title": "Option",
      "type": "object"
    },
    "OptionSet": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "best_option_id": {
          "title": "Best Option Id",
          "type": "string"
        },
        "moment_id": {
          "title": "Moment Id",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        }
      },
      "required": [
        "moment_id",
        "t_ms",
        "actor_id",
        "options",
        "best_option_id"
      ],
      "title": "OptionSet",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 110.0,
          "minimum": -5.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 73.0,
          "minimum": -5.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "ProbRange": {
      "additionalProperties": false,
      "description": "Monte Carlo spread: median with 10th-90th percentile.",
      "properties": {
        "high": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "High",
          "type": "number"
        },
        "low": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Low",
          "type": "number"
        },
        "median": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Median",
          "type": "number"
        }
      },
      "required": [
        "median",
        "low",
        "high"
      ],
      "title": "ProbRange",
      "type": "object"
    },
    "ProfileKind": {
      "enum": [
        "actual",
        "archetype",
        "custom",
        "substitute"
      ],
      "title": "ProfileKind",
      "type": "string"
    },
    "ProfileRef": {
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "anyOf": [
            {
              "$ref": "#/$defs/Archetype"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/ProfileKind"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "title": "ProfileRef",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "p_success": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Success",
          "type": "number"
        },
        "profile": {
          "$ref": "#/$defs/ProfileRef"
        },
        "range": {
          "$ref": "#/$defs/ProbRange"
        }
      },
      "required": [
        "profile",
        "p_success",
        "range"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "WhatIf": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "actual": {
          "$ref": "#/$defs/Scenario"
        },
        "counterfactual": {
          "$ref": "#/$defs/Scenario"
        },
        "drivers": {
          "items": {
            "$ref": "#/$defs/Driver"
          },
          "title": "Drivers",
          "type": "array"
        },
        "ghost_path": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Point"
          },
          "title": "Ghost Path",
          "type": "array"
        },
        "moment_id": {
          "title": "Moment Id",
          "type": "string"
        }
      },
      "required": [
        "moment_id",
        "actor_id",
        "actual",
        "counterfactual",
        "drivers"
      ],
      "title": "WhatIf",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "moment": {
      "$ref": "#/$defs/KeyMoment"
    },
    "options": {
      "anyOf": [
        {
          "$ref": "#/$defs/OptionSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "what_if": {
      "anyOf": [
        {
          "$ref": "#/$defs/WhatIf"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "moment"
  ],
  "title": "MomentAnalysis",
  "type": "object"
}
